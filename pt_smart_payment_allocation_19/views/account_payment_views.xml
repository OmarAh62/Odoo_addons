<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_smart_allocation" model="ir.ui.view">
        <field name="name">account.payment.form.smart.allocation</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_smart_allocation"
                        type="object"
                        string="Smart Allocation"
                        class="btn-primary"
                        icon="fa-magic"
                        groups="account.group_account_user"
                        invisible="payment_type != 'inbound' or partner_type != 'customer' or not move_id or is_reconciled"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_customer_outstanding_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        groups="account.group_account_user"
                        invisible="partner_type != 'customer' or not partner_id or customer_open_invoice_count == 0">
                    <field name="customer_open_invoice_count"
                           widget="statinfo"
                           string="Outstanding Invoices"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='memo']" position="after">
                <field name="company_currency_id" invisible="1"/>

                <separator string="Customer Debt Overview"
                           invisible="partner_type != 'customer' or not partner_id"/>
                <field name="customer_debt_before_payment"
                       readonly="1"
                       invisible="partner_type != 'customer' or not partner_id or state == 'draft'"/>
                <field name="customer_outstanding_amount"
                       readonly="1"
                       invisible="partner_type != 'customer' or not partner_id"/>
                <field name="customer_overdue_amount"
                       readonly="1"
                       invisible="partner_type != 'customer' or not partner_id"/>

                <separator string="Smart Allocation Result"
                           invisible="smart_allocation_state == 'not_suggested'"/>
                <field name="smart_allocation_state" widget="badge" readonly="1"/>
                <field name="smart_allocation_confidence"
                       readonly="1"
                       invisible="smart_allocation_state == 'not_suggested'"/>
                <field name="smart_allocation_note"
                       readonly="1"
                       invisible="not smart_allocation_note"/>
                <field name="smart_existing_backfill"
                       readonly="1"
                       invisible="not smart_existing_backfill"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_smart_allocation" model="ir.ui.view">
        <field name="name">account.payment.list.smart.allocation</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="customer_outstanding_amount" optional="hide"/>
                <field name="customer_overdue_amount" optional="hide"/>
                <field name="smart_allocation_state" widget="badge" optional="hide"/>
                <field name="smart_allocation_confidence" optional="hide"/>
                <field name="smart_existing_backfill" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
