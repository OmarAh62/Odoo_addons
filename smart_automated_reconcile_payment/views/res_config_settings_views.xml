<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_smart_payment_allocation" model="ir.ui.view">
        <field name="name">res.config.settings.form.smart.payment.allocation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="after">
                <block title="Smart Payment Allocation" name="smart_payment_allocation_settings">
                    <setting string="Automatic Customer Payment Allocation"
                             help="Automatically match newly posted inbound customer payments when confidence reaches the configured threshold.">
                        <field name="smart_payment_auto_allocate"/>
                    </setting>
                    <setting string="Default Matching Strategy">
                        <field name="smart_payment_allocation_strategy"/>
                    </setting>
                    <setting string="Automatic Allocation Confidence">
                        <div class="content-group">
                            <field name="smart_payment_confidence_threshold" class="oe_inline"/>
                            <span> %</span>
                        </div>
                    </setting>
                    <setting string="Exact Combination Search Limits"
                             help="These limits protect performance when a customer has many open invoices.">
                        <div class="content-group">
                            <label for="smart_payment_max_combination_size" string="Maximum invoices in one combination"/>
                            <field name="smart_payment_max_combination_size" class="oe_inline"/>
                        </div>
                        <div class="content-group mt8">
                            <label for="smart_payment_candidate_limit" string="Maximum candidate invoices"/>
                            <field name="smart_payment_candidate_limit" class="oe_inline"/>
                        </div>
                    </setting>
                    <setting string="Match Existing Payments and Invoices"
                             help="Enable matching for all currently unreconciled customer payments/credits and open customer invoices.">
                        <field name="smart_match_existing_records"/>
                    </setting>
                    <setting string="Existing Records Matching Mode"
                             invisible="not smart_match_existing_records"
                             help="Choose Automatic for background matching, or Manual Review to let users select customers and run matching themselves.">
                        <field name="smart_existing_matching_mode" widget="radio"/>
                        <div class="content-group mt16" invisible="smart_existing_matching_mode != 'manual'">
                            <button name="action_open_manual_payment_matching"
                                    type="object"
                                    string="Open Manual Payment Matching"
                                    class="btn-primary"
                                    icon="oi-arrow-right"/>
                        </div>
                        <div class="content-group mt16" invisible="smart_existing_matching_mode != 'automatic'">
                            <button name="action_run_existing_matching_now"
                                    type="object"
                                    string="Run Existing Matching Now"
                                    class="btn-primary"
                                    icon="fa-play"/>
                        </div>
                        <div class="text-muted mt8" invisible="smart_existing_matching_mode != 'automatic'">
                            Open payments and customer credits are processed automatically in the background, oldest credit and oldest due invoice first.
                        </div>
                        <div class="text-muted mt8" invisible="smart_existing_matching_mode != 'manual'">
                            Nothing is matched automatically. Select customers from the manual matching screen and click Match.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
