<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_payment_allocation_wizard_form" model="ir.ui.view">
        <field name="name">smart.payment.allocation.wizard.form</field>
        <field name="model">smart.payment.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Smart Payment Allocation">
                <group>
                    <group>
                        <field name="payment_id"/>
                        <field name="partner_id"/>
                        <field name="allocation_mode" widget="radio" options="{'horizontal': True}"/>
                        <field name="strategy"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="existing_backfill" invisible="1"/>
                        <field name="payment_amount"/>
                        <field name="available_amount"/>
                        <field name="suggested_amount"/>
                        <field name="remaining_amount"/>
                        <field name="confidence"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not existing_backfill">
                    Existing-payment mode is active. Only invoices dated on or before the payment date are eligible, and distribution follows oldest due date first.
                </div>
                <div class="alert alert-info" role="alert" invisible="allocation_mode != 'distribute'">
                    The payment can be split across several invoices. Example: 2,000 closes the first invoice and the remaining 3,000 is applied to the next invoice.
                </div>
                <div class="alert alert-warning" role="alert" invisible="allocation_mode != 'single'">
                    Only one invoice can be selected. Any payment amount above that invoice's residual remains as unallocated customer credit.
                </div>
                <div class="alert alert-info" role="alert" invisible="not result_note">
                    <field name="result_note" nolabel="1"/>
                </div>
                <field name="line_ids" nolabel="1">
                    <tree create="0" delete="0" editable="bottom" decoration-success="selected">
                        <field name="sequence" widget="handle"/>
                        <field name="selected"/>
                        <field name="invoice_id"/>
                        <field name="invoice_date"/>
                        <field name="due_date"/>
                        <field name="invoice_currency_id" column_invisible="True"/>
                        <field name="invoice_residual"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="residual_payment_currency"/>
                        <field name="suggested_amount"/>
                        <field name="confidence"/>
                        <field name="match_reason"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_suggest" string="Suggest" type="object" class="btn-primary" icon="fa-magic"/>
                    <button name="action_apply_allocation" string="Apply &amp; Reconcile" type="object" class="btn-success"/>
                    <button name="action_clear_suggestion" string="Clear" type="object" class="btn-secondary"/>
                    <button name="action_reload_invoices" string="Reload Invoices" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
